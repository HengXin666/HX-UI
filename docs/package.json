{
  "name": "@hx/ui-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:icons": "node scripts/check-icons.mjs",
    "check:smoke": "node ../scripts/check-smoke.mjs",
    "check:shell": "node ../scripts/check-shell.mjs",
    "verify": "npm run typecheck && npm run check:icons && npm run build && npm run check:smoke && npm run check:shell"
  },
  "dependencies": {
    "@hx/ui": "file:..",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.13",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
