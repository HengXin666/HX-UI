{
  "name": "@hx/ui-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:icons": "node scripts/check-icons.ts",
    "check:smoke": "node ../scripts/check-smoke.ts",
    "check:shell": "node ../scripts/check-shell.ts",
    "verify": "npm run typecheck && npm run check:icons && npm run build && npm run check:smoke && npm run check:shell",
    "gates": "node ../scripts/gates/run.mjs --group docs,shape,browser",
    "gates:install-hooks": "bash ../scripts/gates/hooks/install.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@hx/ui": "file:..",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.13",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
