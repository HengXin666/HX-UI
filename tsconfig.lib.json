{
  "//": "发布包的类型声明: 只发 src/, 只出 .d.ts. 产物里的 \"@/\" 由 scripts/build-lib.ts 改写成相对路径.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "incremental": false,
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "exclude": ["src/**/*.typetest.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
