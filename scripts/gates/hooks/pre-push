#!/usr/bin/env bash
# pre-push  推送前跑"完整但仍在分钟以内"的那一档。
#
# 与 pre-commit 的分工: 提交路径跑一个固定且廉价的分组集合; 推送路径把
# 浏览器矩阵 (构建 + 逐页冒烟 + 外壳交互, 实测约 20s) 也拉进来。
#
# 它**仍然不含负向探针**  探针要起几十个子进程, 进推送路径的结果是所有人
# 开始习惯 --no-verify。探针在 CI 与手动命令里跑, 那才是它该付的账。
#
# 为什么用 --checkpoint 而不是 --from 按变更集选 lane: 本仓门禁多为全仓分析器,
# 没有"只看这几个文件"的模式; 按文件猜分组会在共享文件改动时判错, 而判错
# 的表现是"一条都不跑"。固定分组集合由 CHECKPOINTS 表声明, 结果可预测。
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo_root"

if [ ! -f "scripts/gates/run.mjs" ]; then
  echo "pre-push: 找不到门禁总线, 本次推送未经验证" >&2
  exit 0
fi

# --from 仍传给总线, 用于输出里说明"这次推送涉及哪些文件"(它不再决定跑哪些分组)
base="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
if [ -z "$base" ]; then
  base="HEAD~1"
fi

exec node scripts/gates/run.mjs --checkpoint pre-push --from "$base"
