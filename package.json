{
  "name": "@hx/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "HX 自维护 UI 库: 视觉沿用 open-vetta 那套设计语言",
  "license": "MIT",
  "files": [
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./spin-variants.css": "./src/spin-variants.css",
    "./motion.css": "./src/motion.css"
  },
  "scripts": {
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/quality/index.ts check --mode all --rule PROJECT-UI-PALETTE,PROJECT-UI-HEX,PROJECT-UI-RGB,PROJECT-UI-LINE-1PX,PROJECT-UI-BW,PROJECT-UI-TRANSITION-ALL,PROJECT-UI-BUTTON-TYPE,PROJECT-UI-ICON-DECLARED --out scripts/.hx_code_quality/reports/ui",
    "check:smoke": "node scripts/check-smoke.ts",
    "check:smoke:strict": "node scripts/check-smoke.ts --strict",
    "check:shell": "node scripts/check-shell.ts",
    "build": "tsc --noEmit && npm run check:ui",
    "verify": "npm run build && npm --prefix docs run build && npm run check:smoke && npm run check:shell",
    "quality": "node scripts/quality/index.ts check --mode worktree",
    "quality:staged": "node scripts/quality/index.ts check --mode staged",
    "quality:all": "node scripts/quality/index.ts check --mode all",
    "quality:done": "node scripts/quality/index.ts done",
    "quality:probes": "node scripts/quality/checks/probes.ts",
    "quality:audit": "node scripts/quality/index.ts audit",
    "hooks:install": "node scripts/quality/index.ts hooks",
    "test": "node scripts/quality/index.ts tests --event full",
    "test:affected": "node scripts/quality/index.ts tests --event local --mode worktree",
    "test:e2e": "npm --prefix docs run build && node scripts/check-smoke.ts && node scripts/check-shell.ts",
    "test:frontend": "node scripts/quality/index.ts layer --name frontend",
    "test:backend": "node scripts/quality/index.ts layer --name backend",
    "test:contract": "node scripts/quality/index.ts layer --name contract",
    "test:perf": "node scripts/quality/index.ts layer --name perf"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.48.0",
    "motion": "^12.34.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.14.0",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
