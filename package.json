{
  "name": "@hx/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "HX 自维护 UI 库: 视觉沿用 open-vetta 那套设计语言",
  "license": "MIT",
  "files": [
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./spin-variants.css": "./src/spin-variants.css"
  },
  "scripts": {
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-rules.mjs src",
    "build": "tsc --noEmit && node scripts/check-ui-rules.mjs src"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.48.0",
    "motion": "^12.34.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.14.0",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
