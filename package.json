{
  "name": "@hx/ui",
  "version": "0.1.2",
  "type": "module",
  "description": "HX 自维护 UI 库: 视觉沿用 open-vetta 那套设计语言",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./spin-variants.css": "./dist/spin-variants.css",
    "./motion.css": "./dist/motion.css",
    "./hxbrowser": {
      "types": "./dist/hxbrowser/index.d.ts",
      "import": "./dist/hxbrowser/index.js"
    },
    "./hxbrowser/protocol": {
      "types": "./dist/hxbrowser/core/protocol.d.ts",
      "import": "./dist/hxbrowser/core/protocol.js"
    },
    "./native-select.css": "./dist/native-select.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/quality/index.ts check --mode all --rule PROJECT-UI-PALETTE,PROJECT-UI-HEX,PROJECT-UI-RGB,PROJECT-UI-LINE-1PX,PROJECT-UI-BW,PROJECT-UI-TRANSITION-ALL,PROJECT-UI-BUTTON-TYPE,PROJECT-UI-ICON-DECLARED,PROJECT-UI-DEV-DIARY,PROJECT-UI-JSX-COMMENT-LEAK --out scripts/.hx_code_quality/reports/ui",
    "check:smoke": "node scripts/check-smoke.ts",
    "check:smoke:strict": "node scripts/check-smoke.ts --strict",
    "check:shell": "node scripts/check-shell.ts",
    "check:blueprint": "node scripts/check-blueprint.mjs",
    "check:blueprint:strict": "node scripts/check-blueprint.mjs --strict",
    "build": "node scripts/gates/run.mjs --group lib",
    "verify": "node scripts/gates/run.mjs --checkpoint pre-push",
    "gates": "node scripts/gates/run.mjs",
    "gates:list": "node scripts/gates/run.mjs --list",
    "gates:staged": "node scripts/gates/run.mjs --checkpoint pre-commit",
    "gates:push": "node scripts/gates/run.mjs --checkpoint pre-push",
    "gates:all": "node scripts/gates/run.mjs --all --strict",
    "gates:probe": "node scripts/gates/run.mjs --group probe",
    "gates:fingerprint": "node scripts/gates/shared/check-fingerprint.mjs --check",
    "gates:install-hooks": "bash scripts/gates/hooks/install.sh",
    "quality": "node scripts/quality/index.ts check --mode worktree",
    "quality:staged": "node scripts/quality/index.ts check --mode staged",
    "quality:all": "node scripts/quality/index.ts check --mode all",
    "quality:done": "node scripts/quality/index.ts done",
    "quality:probes": "node scripts/quality/checks/probes.ts",
    "quality:audit": "node scripts/quality/index.ts audit",
    "hooks:install": "node scripts/quality/index.ts hooks",
    "test": "node scripts/quality/index.ts tests --event full",
    "test:affected": "node scripts/quality/index.ts tests --event local --mode worktree",
    "test:e2e": "npm --prefix docs run build && node scripts/check-smoke.ts --strict && node scripts/check-shell.ts --strict",
    "test:frontend": "node scripts/quality/index.ts layer --name frontend",
    "test:backend": "node scripts/quality/index.ts layer --name backend",
    "test:contract": "node scripts/quality/index.ts layer --name contract",
    "test:perf": "node scripts/quality/index.ts layer --name perf",
    "verify-notes": "uv run scripts/redlines/agent_notes.py --diff",
    "verify-notes:all": "uv run scripts/redlines/agent_notes.py --all",
    "verify-notes:staged": "uv run scripts/redlines/agent_notes.py --staged",
    "build:lib": "node scripts/build-lib.ts",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.48.0",
    "markstream-react": "^2.0.20",
    "monaco-editor": "^0.57.0",
    "motion": "^12.34.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "stream-diffs": "^0.0.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
