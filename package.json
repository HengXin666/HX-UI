{
  "name": "@hx/ui",
  "version": "2.7.0",
  "description": "HX-UI 2: React 19 + Tailwind v4 + shadcn/ui + Motion + Recharts 的组件库 (基础件, 图表, 蓝图编辑器, Agent 界面, 特效)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HengXin666/HX-UI.git"
  },
  "homepage": "https://hengxin666.github.io/HX-UI/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./blueprint": {
      "types": "./dist/blueprint/index.d.ts",
      "default": "./dist/blueprint/index.js"
    },
    "./blueprint/ui": {
      "types": "./dist/blueprint/ui/index.d.ts",
      "default": "./dist/blueprint/ui/index.js"
    },
    "./blueprint/panels": {
      "types": "./dist/blueprint/ui/panels.d.ts",
      "default": "./dist/blueprint/ui/panels.js"
    },
    "./blueprint/variables-panel": {
      "types": "./dist/blueprint/ui/variables-panel.d.ts",
      "default": "./dist/blueprint/ui/variables-panel.js"
    },
    "./blueprint/agent": {
      "types": "./dist/blueprint/agent/index.d.ts",
      "default": "./dist/blueprint/agent/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent/mermaid": {
      "types": "./dist/agent/fences/mermaid-entry.d.ts",
      "default": "./dist/agent/fences/mermaid-entry.js"
    },
    "./agent/math": {
      "types": "./dist/agent/fences/math-entry.d.ts",
      "default": "./dist/agent/fences/math-entry.js"
    },
    "./blueprint/debug": {
      "types": "./dist/blueprint/debug.d.ts",
      "default": "./dist/blueprint/debug.js"
    },
    "./data": {
      "types": "./dist/data/base.d.ts",
      "default": "./dist/data/base.js"
    },
    "./data/3d": {
      "types": "./dist/data/charts3d/index.d.ts",
      "default": "./dist/data/charts3d/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "default": "./dist/motion/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "default": "./dist/effects/index.js"
    },
    "./effects/*": {
      "types": "./dist/effects/*.d.ts",
      "default": "./dist/effects/*.js"
    },
    "./interactions": {
      "types": "./dist/interactions/index.d.ts",
      "default": "./dist/interactions/index.js"
    },
    "./text/*": {
      "types": "./dist/text/*.d.ts",
      "default": "./dist/text/*.js"
    },
    "./backgrounds/*": {
      "types": "./dist/backgrounds/*.d.ts",
      "default": "./dist/backgrounds/*.js"
    },
    "./scroll/*": {
      "types": "./dist/scroll/*.d.ts",
      "default": "./dist/scroll/*.js"
    },
    "./stage": {
      "types": "./dist/stage/stage.d.ts",
      "default": "./dist/stage/stage.js"
    },
    "./stage/shots": {
      "types": "./dist/stage/shots.d.ts",
      "default": "./dist/stage/shots.js"
    },
    "./theme": {
      "types": "./dist/hooks/theme.d.ts",
      "default": "./dist/hooks/theme.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./dist/tokens.json",
    "./components.json": "./dist/components.json",
    "./tailwind.css": "./dist/tailwind.css",
    "./blueprint.css": "./dist/blueprint.css",
    "./blueprint/styles.css": "./dist/blueprint/styles.css",
    "./agent.css": "./dist/agent.css",
    "./agent/styles.css": "./dist/agent/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && vite build",
    "build:lib": "node scripts/build-lib.ts",
    "pack:check": "npm run build:lib && npm pack --json --ignore-scripts > pack.json && node scripts/verify-pack.ts",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:budgets": "node --experimental-strip-types scripts/check-budgets.ts",
    "check:bp": "node scripts/bp-check.ts",
    "check:agent": "node scripts/agent-check.ts",
    "check:client": "node scripts/check-client.ts",
    "check:components": "node scripts/ui-check.ts",
    "check": "npm run check:budgets && npm run check:client && npm run check:components"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.170.0",
    "mermaid": ">=11.0.0",
    "katex": ">=0.16.0",
    "@streamdown/math": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "@streamdown/math": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/geojson": "^7946.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.5",
    "d3-force": "^3.0.1",
    "d3-geo": "^3.1.2",
    "d3-hierarchy": "^3.1.3",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.11.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.8.1",
    "tailwind-merge": "^3.7.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@streamdown/math": "^1.0.4",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "date-fns": "^4.4.0",
    "katex": "^0.16.47",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "5.9",
    "vite": "^8.3.8"
  }
}
